<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="hello.ui5.controller.Main">

    <App>
        <pages>
            <Page title="XML UI5 App" class="appPage">
                <content>
                    <VBox width="100%" class="appShell">
                        <VBox width="100%" class="appCard" alignItems="Stretch">
                            <Text text="Hello Vishnu from XML 🚀" class="heroTitle" />
                            <HBox alignItems="Center" renderType="Bare" class="ctaRow">
                                <Button text="Click Me" press=".onPress" type="Emphasized" class="primaryBtn" />
                                <Button text="View Folder" press=".onViewFolder" class="ghostBtn" />
                            </HBox>
                            <HBox alignItems="Center" renderType="Bare" class="inputRow">
                                <Input width="16rem" placeholder="Type your name" value="{/name}" class="nameInput" />
                                <Text text="{= ${/name} ? 'Hi ' + ${/name} : '' }" class="greetText" />
                            </HBox>
                        </VBox>
                    </VBox>
                </content>
            </Page>
        </pages>
    </App>

</mvc:View>
